# ── Frontend (Vercel → Environment Variables, y local .env) ─────────────────
VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=ey...

# VAPID public key para Web Push (la privada va en secrets de Supabase)
VITE_VAPID_PUBLIC_KEY=

# ── Secrets del backend (Supabase → supabase secrets set …) ─────────────────
# NO van en el frontend. Se registran con el CLI (ver SETUP.md).
#
#   SUPABASE_SERVICE_ROLE_KEY   (Supabase la inyecta sola en Edge Functions)
#   LIVEKIT_URL=wss://TU.livekit.cloud
#   LIVEKIT_API_KEY=API...
#   LIVEKIT_API_SECRET=...
#   LIVEKIT_S3_BUCKET=call-recordings
#   WHATSAPP_TOKEN=EAAG...            (System User token permanente)
#   WA_PHONE_NUMBER_ID=...            (número de WhatsApp Cloud API)
#   WHATSAPP_TEMPLATE_LANG=es
#   VAPID_PUBLIC_KEY=...
#   VAPID_PRIVATE_KEY=...
#   AI_API_KEY=...                    (proveedor de IA del quiz)
#   AI_MODEL=claude-sonnet-5
